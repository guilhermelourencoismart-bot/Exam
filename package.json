{
  "name": "insper-pessoal",
  "version": "0.4.2",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:extract": "python3 scripts/extract.py",
    "data:check": "python3 scripts/extract.py --check",
    "sources:inspect": "python3 scripts/inspect_sources.py",
    "test:sources": "python3 -m unittest discover -s tests -p 'test*source*.py' -v"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "jose": "6.1.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
